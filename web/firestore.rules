rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // Allow anyone to read profiles (e.g. to view freelancers and client details)
      allow read: if true;
      
      // Allow writes to the user document for registration, updates, and soft deletion
      allow write: if true;
    }
  }
}
