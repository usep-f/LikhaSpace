rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ───────────────────────────────────────────────
    // USERS
    // ───────────────────────────────────────────────
    match /users/{userId} {
      // Anyone can read public profiles (for marketplace browsing)
      allow read: if true;

      // Only the authenticated wallet owner can write to their own document.
      // request.auth.uid === Stellar public key (set by Firebase Custom Token).
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ───────────────────────────────────────────────
    // GIGS
    // ───────────────────────────────────────────────
    match /gigs/{gigId} {
      // Anyone can browse gigs
      allow read: if true;

      // Only authenticated users can create a gig
      allow create: if request.auth != null
        && request.resource.data.freelancerAddress == request.auth.uid;

      // Only the gig owner (freelancer) can delete their own gig
      allow delete: if request.auth != null
        && resource.data.freelancerAddress == request.auth.uid;

      // Only the gig owner can update any field, or any authenticated user can update only rating and reviewsCount
      allow update: if request.auth != null
        && (
          resource.data.freelancerAddress == request.auth.uid
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'reviewsCount'])
        );
    }

    // ───────────────────────────────────────────────
    // ORDERS
    // ───────────────────────────────────────────────
    match /orders/{orderId} {
      // Only order participants or a mediator can read
      allow read: if request.auth != null
        && (resource.data.clientAddress == request.auth.uid
         || resource.data.freelancerAddress == request.auth.uid
         || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'mediator');

      // Only an authenticated client can create an order (they are the buyer)
      allow create: if request.auth != null
        && request.resource.data.clientAddress == request.auth.uid;

      // Only the client, freelancer, or mediator can update it, and they can only modify specific mutable fields
      allow update: if request.auth != null
        && (resource.data.clientAddress == request.auth.uid
         || resource.data.freelancerAddress == request.auth.uid
         || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'mediator')
        && request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['status', 'changelogs', 'chatMessages', 'currentMilestoneIdx', 'milestones', 'denialMessage', 'txHash', 'progressPercentage', 'review', 'hasSubmittedOnce'])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['chatMessages'])
          || (
            request.resource.data.get('chatMessages', []).size() == resource.data.get('chatMessages', []).size() + 1
            && request.resource.data.get('chatMessages', []).hasAll(resource.data.get('chatMessages', []))
            && request.resource.data.get('chatMessages', [])[resource.data.get('chatMessages', []).size()].senderAddress == request.auth.uid
          )
        );

      // Deletion not permitted — orders are permanent audit records
      allow delete: if false;
    }
    // ───────────────────────────────────────────────
    // NOTIFICATIONS
    // ───────────────────────────────────────────────
    match /notifications/{notificationId} {
      allow read, delete: if request.auth != null && resource.data.recipientId == request.auth.uid;
      allow update: if request.auth != null && resource.data.recipientId == request.auth.uid 
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create: if request.auth != null 
                    && request.resource.data.senderId == request.auth.uid
                    && request.resource.data.read == false;
    }
  }
}
